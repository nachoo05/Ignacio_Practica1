<Window x:Class="PortalVideojuegos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEON ARCADE - Retro Gaming Portal" 
        Height="640" Width="1000"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen" 
        Background="#0B0813"
        FontFamily="Consolas, 'Segoe UI', monospace">

    <Window.Resources>
        <!-- Brillos de Neón -->
        <DropShadowEffect x:Key="CyanGlow" Color="#00F0FF" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
        <DropShadowEffect x:Key="PinkGlow" Color="#FF007F" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>

        <!-- Estilo Navegación Superior -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C2B5DE"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A1B4D"/>
                                <Setter Property="Foreground" Value="#00F0FF"/>
                                <Setter TargetName="border" Property="Effect" Value="{StaticResource CyanGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Menú Lateral -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#171226"/>
            <Setter Property="Foreground" Value="#DDD6FE"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#38295C"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2D124D"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FF007F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="btnBorder" Property="Effect" Value="{StaticResource PinkGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================== -->
        <!-- 1. BARRA SUPERIOR                              -->
        <!-- ============================================== -->
        <Border Grid.Row="0" Grid.Column="1" 
                Background="#130F24" 
                CornerRadius="12" 
                BorderBrush="#2B2048" 
                BorderThickness="1.5" 
                Padding="10,6" 
                Margin="15,0,0,15">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="TIENDA" Click="BtnTienda_Click" Style="{StaticResource NavButtonStyle}" Foreground="#00F0FF"/>
                    <Button Content="COMUNIDAD" Click="BtnComunidad_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="SOPORTE" Click="BtnSoporte_Click" Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>

                <!-- Botón de Perfil interactivo -->
                <!-- CornerRadius removed: use template if rounded button needed -->
                <Button x:Name="BtnPerfil" Click="BtnPerfil_Click" DockPanel.Dock="Right" 
                        Background="#20153D" BorderBrush="#FF007F" BorderThickness="1.2" 
                        Padding="10,5" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11" Background="#FF007F" Margin="0,0,8,0">
                            <TextBlock Text="P1" Foreground="White" FontSize="10" FontWeight="Bold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPerfilEtiqueta" Text="mi perfil" Foreground="White" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="LVL 42 · ONLINE" Foreground="#00FF66" FontSize="8"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- ============================================== -->
        <!-- 2. MENÚ LATERAL IZQUIERDO                      -->
        <!-- ============================================== -->
        <Border Grid.Row="1" Grid.Column="0" 
                CornerRadius="16" 
                BorderBrush="#BD00FF" 
                BorderThickness="1.5" 
                Background="#130F24" 
                Padding="16" 
                Margin="0,0,5,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,5,0,20">
                    <TextBlock Text="RETRO HUB" Foreground="#FFE600" FontWeight="Black" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Text="ARCADE STATION" Foreground="#6C5C8A" FontSize="10" HorizontalAlignment="Center"/>
                    <Separator Background="#2B2048" Margin="0,12,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <Button Content="★  Destacados" Click="BtnDestacados_Click" Style="{StaticResource SidebarButtonStyle}" 
                            BorderBrush="#FFE600" Foreground="#FFE600" Background="#261E38"/>
                    <Button Content="🕹  Mis juegos" Click="BtnMisJuegos_Click" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="⚙  Configuración" Click="BtnConfiguracion_Click" Style="{StaticResource SidebarButtonStyle}"/>
                </StackPanel>

                <Border Grid.Row="2" Background="#0A0612" CornerRadius="8" Padding="8" BorderBrush="#251C3B" BorderThickness="1" Margin="0,0,0,10">
                    <TextBlock Text="CREDITS: 04" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                </Border>

                <!-- Botón Salir -->
                <Button Grid.Row="3" Content="🚪 SALIR" Click="BtnSalir_Click" Height="36" 
                        Background="#A62828" Foreground="White" FontWeight="Bold" FontSize="12"
                        BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- 3. PANEL CENTRAL CAMBIANTE                     -->
        <!-- ============================================== -->
        <Border Grid.Row="1" Grid.Column="1" 
                CornerRadius="16" 
                BorderBrush="#00F0FF" 
                BorderThickness="1.5" 
                Background="#130F24" 
                Padding="16" 
                Margin="15,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- VISTA 1: CATÁLOGO DE JUEGOS RETRO (CON SÍMBOLOS) -->
                <Grid x:Name="VistaTienda" Grid.Row="0" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="6,0,6,14">
                        <TextBlock Text="⚡ CATÁLOGO RETRO DESTACADO" Foreground="#00F0FF" FontWeight="Black" FontSize="14"/>
                        <TextBlock Text="6 TÍTULOS DISPONIBLES" Foreground="#FFE600" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">

                            <!-- JUEGO 1: SPACE INVADERS -->
                            <Border Width="170" Height="150" Margin="8" Background="#1B1433" CornerRadius="10" BorderBrush="#FF007F" BorderThickness="1.2">
                                <Grid Margin="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="👾" FontSize="34" HorizontalAlignment="Center"/>
                                        <TextBlock Text="SPACE INVADERS" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock Text="Taito · 1978" Foreground="#8E80A8" FontSize="9" HorizontalAlignment="Center"/>
                                        <TextBlock Text="★★★★★" Foreground="#FFE600" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                        <Button Content="JUGAR" Click="BtnJugar_Click" Tag="Space Invaders" Height="22" Background="#FF007F" Foreground="White" FontWeight="Bold" FontSize="10" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- JUEGO 2: PAC-MAN -->
                            <Border Width="170" Height="150" Margin="8" Background="#1B1433" CornerRadius="10" BorderBrush="#FFE600" BorderThickness="1.2">
                                <Grid Margin="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🟡" FontSize="34" HorizontalAlignment="Center"/>
                                        <TextBlock Text="PAC-MAN" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock Text="Namco · 1980" Foreground="#8E80A8" FontSize="9" HorizontalAlignment="Center"/>
                                        <TextBlock Text="★★★★★" Foreground="#FFE600" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                        <Button Content="JUGAR" Click="BtnJugar_Click" Tag="Pac-Man" Height="22" Background="#FFE600" Foreground="#121212" FontWeight="Bold" FontSize="10" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- JUEGO 3: STREET FIGHTER II -->
                            <Border Width="170" Height="150" Margin="8" Background="#1B1433" CornerRadius="10" BorderBrush="#00F0FF" BorderThickness="1.2">
                                <Grid Margin="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🥊" FontSize="34" HorizontalAlignment="Center"/>
                                        <TextBlock Text="STREET FIGHTER II" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock Text="Capcom · 1991" Foreground="#8E80A8" FontSize="9" HorizontalAlignment="Center"/>
                                        <TextBlock Text="★★★★★" Foreground="#FFE600" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                        <Button Content="JUGAR" Click="BtnJugar_Click" Tag="Street Fighter II" Height="22" Background="#00F0FF" Foreground="#0A101D" FontWeight="Bold" FontSize="10" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- JUEGO 4: TETRIS -->
                            <Border Width="170" Height="150" Margin="8" Background="#1B1433" CornerRadius="10" BorderBrush="#BD00FF" BorderThickness="1.2">
                                <Grid Margin="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🧱" FontSize="34" HorizontalAlignment="Center"/>
                                        <TextBlock Text="TETRIS" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock Text="Elorg · 1984" Foreground="#8E80A8" FontSize="9" HorizontalAlignment="Center"/>
                                        <TextBlock Text="★★★★☆" Foreground="#FFE600" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                        <Button Content="JUGAR" Click="BtnJugar_Click" Tag="Tetris" Height="22" Background="#BD00FF" Foreground="White" FontWeight="Bold" FontSize="10" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- JUEGO 5: DOOM -->
                            <Border Width="170" Height="150" Margin="8" Background="#1B1433" CornerRadius="10" BorderBrush="#FF007F" BorderThickness="1.2">
                                <Grid Margin="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="💀" FontSize="34" HorizontalAlignment="Center"/>
                                        <TextBlock Text="DOOM (1993)" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock Text="id Software · 1993" Foreground="#8E80A8" FontSize="9" HorizontalAlignment="Center"/>
                                        <TextBlock Text="★★★★★" Foreground="#FFE600" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                        <Button Content="JUGAR" Click="BtnJugar_Click" Tag="Doom" Height="22" Background="#FF007F" Foreground="White" FontWeight="Bold" FontSize="10" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- JUEGO 6: SONIC THE HEDGEHOG -->
                            <Border Width="170" Height="150" Margin="8" Background="#1B1433" CornerRadius="10" BorderBrush="#00F0FF" BorderThickness="1.2">
                                <Grid Margin="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🦔" FontSize="34" HorizontalAlignment="Center"/>
                                        <TextBlock Text="SONIC THE HEDGEHOG" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock Text="SEGA · 1991" Foreground="#8E80A8" FontSize="9" HorizontalAlignment="Center"/>
                                        <TextBlock Text="★★★★★" Foreground="#FFE600" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                        <Button Content="JUGAR" Click="BtnJugar_Click" Tag="Sonic the Hedgehog" Height="22" Background="#00F0FF" Foreground="#0A101D" FontWeight="Bold" FontSize="10" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </WrapPanel>
                    </ScrollViewer>
                </Grid>

                <!-- VISTA 2: MI PERFIL -->
                <Grid x:Name="VistaPerfil" Grid.Row="0" Visibility="Collapsed" Margin="10">
                    <StackPanel>
                        <TextBlock Text="PERFIL DEL JUGADOR" Foreground="#00F0FF" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                        <Border Background="#1C1536" CornerRadius="8" BorderBrush="#BD00FF" BorderThickness="1" Padding="15" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="👾 ID: Player_1 [Pro Gamer]" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="● Rango: Maestro Arcade" Foreground="#FFE600" FontSize="11" Margin="0,5,0,0"/>
                                <TextBlock Text="● Partidas Ganadas: 248" Foreground="#00FF66" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- VISTA 3: OTRAS SECCIONES -->
                <Grid x:Name="VistaGenerica" Grid.Row="0" Visibility="Collapsed" Margin="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtTituloGenerico" Text="SECCIÓN" Foreground="#FFE600" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Área en mantenimiento o esperando datos." Foreground="#8E80A8" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Barra inferior de estado -->
                <Border Grid.Row="1" Background="#0A0612" CornerRadius="6" Padding="10,6" Margin="0,10,0,0" BorderBrush="#251C3B" BorderThickness="1">
                    <TextBlock x:Name="TxtEstado" Text="READY: Esperando acción del jugador..." Foreground="#00FF66" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>